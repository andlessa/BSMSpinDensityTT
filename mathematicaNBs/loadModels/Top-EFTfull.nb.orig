 RowBox[{
  RowBox[{"yukReplacements", " ", "=", 
   RowBox[{"Cases", "[", 
    RowBox[{"parsReplacements", ",", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"a_", "->", 
        RowBox[{"{", "b__", "}"}]}], "]"}], "->", " ", "b"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yukReplacements", "=", 
