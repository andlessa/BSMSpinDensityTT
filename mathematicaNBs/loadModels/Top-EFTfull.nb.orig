               RowBox[{"mChi", "^", "2"}], "/", 
               RowBox[{"mST", "^", "2"}]}], "]"}]}]}], " ", "}"}]}], ",", 
         RowBox[{"{", "yDM", "}"}], ",", "FullSimplify"}], "]"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "frZ", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
