         RowBox[{"Sqrt", "[", "lB", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", "xC", "-", "xT"}], ")"}]}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
