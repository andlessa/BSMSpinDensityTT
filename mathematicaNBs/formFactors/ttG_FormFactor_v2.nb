   \\text{mChi}^2}{\\text{mST}^2}+\\frac{\\text{MT}^2}{\\text{mST}^2}+\\log \
(x)-2\\right)-(x-1)^2 \\log (x)\\right)-4
   \\log \\left(\\frac{\\sqrt{\\lambda }-x_t+x+1}{2 \\sqrt{x}}\\right) \
\\left(\\left(\\frac{\\text{mChi}^2
   \\left(\\text{mChi}^2+\\text{mST}^2\\right)}{\\text{mST}^4}-2\\right)
   x_t+\\frac{\\text{MT}^4}{\\text{mST}^4}-(x-1)^3\\right)\\right)}{128 \\pi \
^4 \\sqrt{\\lambda } \\text{MT}^4}\
\>", "Output",
 CellChangeTimes->{
  3.909821617860457*^9, {3.9098220176445427`*^9, 3.909822025377672*^9}, 
   3.9098221510516768`*^9, 3.909822258520343*^9, 3.909823003562557*^9, 
   3.909828562546349*^9, {3.909828624724222*^9, 3.909828632759132*^9}, 
   3.991827016969985*^9},
 CellLabel->
  "Out[115]//TeXForm=",ExpressionUUID->"95bbfb1b-96d4-43b9-bdeb-b26686f978df"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"deltaCTRexp", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"deltaCTR", "/.", "SubsCT"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xC", "\[Rule]", "x"}], ",", 
      RowBox[{"xT", "\[Rule]", " ", 
       SubscriptBox["x", "t"]}], ",", 
      RowBox[{"lA", "\[Rule]", " ", "\[Lambda]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.909821995738689*^9, 3.9098220098315907`*^9}, {
  3.909822164425618*^9, 3.9098221698937073`*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"75f99263-e37c-46b2-b54e-048a9c2b69dc"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SuperscriptBox["mST", "4"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["x", "t"]}], "+", "x", "-", "1"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             SuperscriptBox["mChi", "2"], 
             SuperscriptBox["mST", "2"]], "-", "2"}], ")"}]}], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["x", "t"], "-", "1"}], ")"}], "2"]}], ")"}], " ", 
       RowBox[{"log", "(", 
        FractionBox[
         RowBox[{
          SqrtBox["\[Lambda]"], "-", 
          SubscriptBox["x", "t"], "+", "x", "+", "1"}], 
         RowBox[{"2", " ", 
          SqrtBox["x"]}]], ")"}]}], "+", 
      RowBox[{
       SqrtBox["\[Lambda]"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          SubscriptBox["x", "t"]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["x", "t"], "+", "x", "-", "1"}], ")"}], " ", 
          RowBox[{"log", "(", "x", ")"}]}]}], ")"}]}]}], ")"}]}], 
   RowBox[{"128", " ", 
    SuperscriptBox["\[Pi]", "4"], " ", 
    SqrtBox["\[Lambda]"], " ", 
    SuperscriptBox["MT", "4"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{3.9098220189425697`*^9, 3.909822261021102*^9, 
  3.909823003890991*^9, 3.909828562826181*^9, 3.909829012314693*^9, 
  3.991827017642293*^9},
