Cell[TextData[{
 "Finally, for convenience, define pB1h to artificial numerical divergences :\
\n",
 StyleBox["(note that ", "Text"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SuperscriptBox["p", "2"], "-", 
       SuperscriptBox["MT", "2"]}]], 
     RowBox[{"B1h", "[", 
      SuperscriptBox["p", "2"], "]"}]}], "->", 
    RowBox[{
     RowBox[{
      RowBox[{"DB1", "[", 
       SuperscriptBox["MT", "2"], "]"}], "  ", "for", " ", 
      SuperscriptBox["p", "2"]}], "->", " ", 
     SuperscriptBox["MT", "2"]}]}], TraditionalForm]], "Text",
  FormatType->TraditionalForm,ExpressionUUID->
  "11ae6791-77f6-4b54-8a05-9850ee1e937e"], "Text"],
 StyleBox[", so ", "Text"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"pB1h", "[", 
     SuperscriptBox["p", "2"], "]"}], "->"}], TraditionalForm]], "Text",
  FormatType->TraditionalForm,ExpressionUUID->
  "c826a041-b8ce-441b-a4f1-dde318e3b1b2"], "Text"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"DB1h", "[", 
      SuperscriptBox["MT", "2"], "]"}], "  ", "for", " ", 
     SuperscriptBox["p", "2"]}], "->", " ", 
    SuperscriptBox["MT", "2"]}], TraditionalForm]], "Text",ExpressionUUID->
  "d79f86ca-60b1-4b39-8847-b9259e0f2b81"], "Text"],
 StyleBox[")", "Text"]
}], "Subsection",
 CellChangeTimes->{{3.99233856501301*^9, 3.99233860494939*^9}, {
