Cell[BoxData[{
 RowBox[{
  RowBox[{"CTsubs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"deltaZG", "->", "0"}], ",", 
     RowBox[{"deltaaS", "->", "0"}], ",", 
     RowBox[{"deltaZL", " ", "->", " ", 
