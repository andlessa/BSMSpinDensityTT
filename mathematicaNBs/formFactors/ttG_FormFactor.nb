Cell["Compute Amplitude", "Section",
 CellChangeTimes->{{3.992114918141325*^9, 
  3.992114924277549*^9}},ExpressionUUID->"daa04c7f-fee8-492c-ae83-\
752662a6b344"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ampA", "=", 
   RowBox[{
    RowBox[{"FCFAConvert", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"CreateFeynAmp", "[", 
        RowBox[{"goodDiags", ",", 
         RowBox[{"PreFactor", "\[Rule]", "1"}], ",", 
         RowBox[{"Truncated", "\[Rule]", "True"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"SUNT", "\[Rule]", "FASUNT"}], "}"}]}], ",", 
      RowBox[{"IncomingMomenta", "\[Rule]", 
       RowBox[{"{", "p3", "}"}]}], ",", 
      RowBox[{"OutgoingMomenta", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "p1"}], ",", 
         RowBox[{"-", "p2"}]}], "}"}]}], ",", 
      RowBox[{"LoopMomenta", "\[Rule]", 
       RowBox[{"{", "q", "}"}]}], ",", 
      RowBox[{"List", "\[Rule]", "False"}], ",", 
      RowBox[{"SUNIndexNames", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"cc3", ",", "aa", ",", "bb"}], "}"}]}], ",", 
      RowBox[{"SUNFIndexNames", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"a", ",", "c1", ",", "c2"}], "}"}]}], ",", 
      RowBox[{"DropSumOver", "\[Rule]", "True"}], ",", 
      RowBox[{"LorentzIndexNames", "\[Rule]", 
       RowBox[{"{", " ", "\[Mu]", "}"}]}], ",", " ", 
      RowBox[{"SMP", "\[Rule]", "True"}], ",", 
      RowBox[{"List", "\[Rule]", "False"}], ",", 
      RowBox[{"Contract", "\[Rule]", "True"}], ",", 
      RowBox[{"ChangeDimension", "\[Rule]", "D"}], ",", 
      RowBox[{"UndoChiralSplittings", "\[Rule]", "True"}], ",", 
      RowBox[{"FinalSubstitutions", "\[Rule]", " ", 
       RowBox[{"(", 
        RowBox[{"M$FACouplings", "/.", 
         RowBox[{"GS", "\[Rule]", "gs"}]}], ")"}]}]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"GS", "\[Rule]", "gs"}], ",", 
      RowBox[{
       RowBox[{"FR$deltaZ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"G", ",", "G"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", "}"}], "}"}]}], "]"}], "->", "deltaZG"}], ",", 
      RowBox[{
       RowBox[{"FR$deltaZ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", ",", "t"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", "}"}], "}"}], ",", "\"\<L\>\""}], "]"}], "->", 
       "deltaZL"}], ",", 
      RowBox[{
       RowBox[{"FR$deltaZ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", ",", "t"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", "}"}], "}"}], ",", "\"\<R\>\""}], "]"}], "->", 
       "deltaZR"}], ",", 
      RowBox[{
       RowBox[{"FR$delta", "[", 
        RowBox[{
         RowBox[{"{", "MT", "}"}], ",", 
         RowBox[{"{", "}"}]}], "]"}], "->", "deltaM"}], ",", 
      RowBox[{
       RowBox[{"FR$delta", "[", 
        RowBox[{
         RowBox[{"{", "aS", "}"}], ",", 
         RowBox[{"{", "}"}]}], "]"}], "->", "deltaaS"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ampB", " ", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"SUNSimplify", "[", 
     RowBox[{"DiracSimplify", "[", 
      RowBox[{"FCReplaceMomenta", "[", 
       RowBox[{"ampA", ",", 
        RowBox[{"{", 
         RowBox[{"p3", "\[Rule]", 
          RowBox[{
           RowBox[{"-", "p1"}], "-", "p2"}]}], "}"}]}], "]"}], "]"}], "]"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.904161850593676*^9, 3.904161897767714*^9}, {
   3.90416195323462*^9, 3.90416200530408*^9}, {3.904162273669128*^9, 
