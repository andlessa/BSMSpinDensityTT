    RowBox[{
     RowBox[{"cc3", "->", "gluonIndex"}], ",", 
     RowBox[{"c2", "->", "topIndex"}], ",", 
     RowBox[{"c1", "->", "antiTopIndex"}]}], "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opts", "=", 
