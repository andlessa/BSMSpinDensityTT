          RowBox[{"{", "}"}], "}"}], ",", "\"\<R\>\""}], "]"}], "->", 
       "deltaZR"}], ",", 
      RowBox[{
       RowBox[{"FR$delta", "[", 
        RowBox[{
         RowBox[{"{", "MT", "}"}], ",", 
         RowBox[{"{", "}"}]}], "]"}], "->", "deltaM"}], ",", 
      RowBox[{
       RowBox[{"FR$delta", "[", 
        RowBox[{
         RowBox[{"{", "aS", "}"}], ",", 
         RowBox[{"{", "}"}]}], "]"}], "->", "deltaaS"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ampB", " ", "=", 
