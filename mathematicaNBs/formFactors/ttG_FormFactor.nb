    RowBox[{"coeff", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"Expand", "[", "ampEsimp6", "]"}], ",", "diracStructure"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ampEsimp6", "=", 
