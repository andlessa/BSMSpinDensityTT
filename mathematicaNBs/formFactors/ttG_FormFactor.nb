Cell[CellGroupData[{

Cell["Construct ALOHA terms\t", "Section",
 CellChangeTimes->{{3.90282439728789*^9, 3.9028244054044323`*^9}, 
   3.9918959146955013`*^9},ExpressionUUID->"5fc0cf35-cb42-48a1-8dde-\
ea21b9983ee2"],

Cell["\<\
UFO conventions:
ProjM -> Gamma[7], ProjP -> Gamma[6]
particles = [ P.t__tilde __, P.t, P.g ] ] = [ p1=P(*,1),  p2=P(*,2), \
p3(\[Mu])=P(*,3) ] (all momenta are incoming)
c2 = Top color = \"2\", c1 = Anti-Top color = \"1\", c3 = Gluon color = \"3\"
spins = [2, 2, 3], 
structure = ' P (4, 3)*Gamma (3, 2, -1)*ProjP (-1, 1) - P (3, 4)*Gamma (4, 2, \
-1)*ProjP (-1, 1)')
(The indices of the product of gamma matrices are always M(2,1), since the \
second (outgoing) top is contracted to the left and the first (incoming) to \
the right)\
\>", "Text",
 CellChangeTimes->{{3.9028244127388268`*^9, 3.9028244572997704`*^9}, {
  3.9028245494877653`*^9, 3.902824565289369*^9}, {3.902825135407077*^9, 
  3.902825165986191*^9}, {3.9028252069681892`*^9, 3.902825209358458*^9}, {
  3.902827635902626*^9, 3.9028276404204607`*^9}, {3.902828503425274*^9, 
  3.902828598854724*^9}, {3.902828648303794*^9, 3.902828650321616*^9}, {
  3.902841286902041*^9, 3.902841414274*^9}, {3.9041625877972116`*^9, 
  3.90416258819027*^9}, {3.9041626214296503`*^9, 3.904162630902267*^9}, {
  3.904162681151655*^9, 3.904162741968356*^9}, {3.904163156304696*^9, 
  3.904163158544257*^9}, {3.90423483441535*^9, 3.904234835828045*^9}, {
  3.90429673259059*^9, 3.9042968098143663`*^9}, {3.992115027003318*^9, 
  3.9921150567695417`*^9}},ExpressionUUID->"f2b4454b-4ed2-45b8-ba46-\
4b3a38e9dde2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gluonIndex", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"topIndex", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"antiTopIndex", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"leftIndex", "=", "topIndex"}], ";"}], "\[IndentingNewLine]", 
