Cell[BoxData[{
 RowBox[{
  RowBox[{"CTsubs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"deltaZG", "->", "0"}], ",", 
     RowBox[{"deltaaS", "->", "0"}], ",", 
     RowBox[{"deltaZL", " ", "->", " ", 
      RowBox[{
       RowBox[{"Pi", "^", "2"}], 
       RowBox[{"yDM", "^", "2"}], "  ", 
       RowBox[{"MT", "^", "2"}], "  ", 
       RowBox[{"Re", "[", 
        RowBox[{"DB1", "[", 
         RowBox[{
          RowBox[{"MT", "^", "2"}], ",", 
          RowBox[{"mChi", "^", "2"}], ",", 
          RowBox[{"mST", "^", "2"}], ",", 
          RowBox[{"BReduce", "->", "False"}]}], "]"}], "]"}]}]}], ",", 
     RowBox[{"deltaZR", "->", " ", 
      RowBox[{
       RowBox[{"Pi", "^", "2"}], "  ", 
       RowBox[{"yDM", "^", "2"}], 
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"MT", "^", "2"}], " ", 
          RowBox[{"Re", "[", 
           RowBox[{"DB1", "[", 
            RowBox[{
             RowBox[{"MT", "^", "2"}], ",", 
             RowBox[{"mChi", "^", "2"}], ",", 
             RowBox[{"mST", "^", "2"}], ",", 
             RowBox[{"BReduce", "->", "False"}]}], "]"}], "]"}]}], "+", 
         RowBox[{"Re", "[", 
          RowBox[{"B1", "[", 
           RowBox[{
            RowBox[{"MT", "^", "2"}], ",", 
            RowBox[{"mChi", "^", "2"}], ",", 
            RowBox[{"mST", "^", "2"}], ",", 
            RowBox[{"BReduce", "->", "False"}]}], "]"}], "]"}]}], ")"}]}]}], 
     ",", 
     RowBox[{"deltaM", "->", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"Pi", "^", "2"}], "2"]}], 
       RowBox[{"yDM", "^", "2"}], " ", "MT", " ", 
       RowBox[{"Re", "[", 
        RowBox[{"B1", "[", 
         RowBox[{
          RowBox[{"MT", "^", "2"}], ",", 
          RowBox[{"mChi", "^", "2"}], ",", 
          RowBox[{"mST", "^", "2"}], ",", 
          RowBox[{"BReduce", "->", "False"}]}], "]"}], "]"}]}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ampB2", "=", 
   RowBox[{"ampB", "/.", "CTsubs"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992084908251506*^9, 3.992085037885786*^9}, {
