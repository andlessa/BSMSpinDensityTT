     RowBox[{"p2", "->", "topIndex"}], ",", 
     RowBox[{"p3", "->", "gluonIndex"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lorentzMap", "=", 
   RowBox[{"<|", 
    RowBox[{"\[Mu]", "->", "gluonIndex"}], "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colorMap", "=", 
