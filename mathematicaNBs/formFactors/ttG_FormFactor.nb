Cell["\<\
Once we convert the p - slash terms below by + - MT (since they apply to \
external spinors), the above result reproduces what was obtained in 2312.00670\
\>", "Text",
 CellChangeTimes->{{3.9923379106346397`*^9, 
  3.992337924955987*^9}},ExpressionUUID->"76ead7d8-0c38-4f50-ad10-\
29de62713d79"]
}, Open  ]],

