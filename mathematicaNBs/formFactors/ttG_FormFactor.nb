Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hasgQ", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Count", "[", 
      RowBox[{"#", ",", 
       RowBox[{"DiracGamma", "[", 
        RowBox[{"n", ",", "D"}], "]"}], ",", "All"}], "]"}], "==", "1"}], 
    "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hasgmuQ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Count", "[", 
      RowBox[{"#", ",", 
       RowBox[{"DiracGamma", "[", 
        RowBox[{
         RowBox[{"LorentzIndex", "[", 
          RowBox[{"\[Mu]", ",", "D"}], "]"}], ",", "D"}], "]"}], ",", "All"}],
       "]"}], "==", "1"}], "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"haspQ", "[", "p_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Count", "[", 
      RowBox[{"#", ",", 
       RowBox[{"Momentum", "[", 
        RowBox[{"p", ",", "D"}], "]"}], ",", "All"}], "]"}], "==", "1"}], 
    "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"first", "[", 
    RowBox[{"list_", ",", "pred_"}], "]"}], ":=", 
   RowBox[{"FirstCase", "[", 
    RowBox[{"list", ",", 
     RowBox[{"_", "?", "pred"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"subsets", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"gmu", "->", 
      RowBox[{"Select", "[", 
       RowBox[{"diracStructures", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"!", 
           RowBox[{
            RowBox[{"haspQ", "[", "p1", "]"}], "[", "#", "]"}]}], "&&", 
          RowBox[{"!", 
           RowBox[{
            RowBox[{"haspQ", "[", "p2", "]"}], "[", "#", "]"}]}], "&&", 
          RowBox[{"hasgmuQ", "[", "#", "]"}]}], "&"}]}], "]"}]}], ",", 
     RowBox[{"p1gmu", "->", 
      RowBox[{"Select", "[", 
       RowBox[{"diracStructures", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"haspQ", "[", "p1", "]"}], "[", "#", "]"}], "&&", 
          RowBox[{"!", 
           RowBox[{
            RowBox[{"haspQ", "[", "p2", "]"}], "[", "#", "]"}]}], "&&", 
          RowBox[{"hasgmuQ", "[", "#", "]"}]}], "&"}]}], "]"}]}], ",", 
     RowBox[{"p2gmu", "->", 
      RowBox[{"Select", "[", 
       RowBox[{"diracStructures", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"!", 
           RowBox[{
            RowBox[{"haspQ", "[", "p1", "]"}], "[", "#", "]"}]}], "&&", 
          RowBox[{
           RowBox[{"haspQ", "[", "p2", "]"}], "[", "#", "]"}], "&&", 
          RowBox[{"hasgmuQ", "[", "#", "]"}]}], "&"}]}], "]"}]}]}], "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"rules", "=", 
  RowBox[{"KeyValueMap", "[", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lhs", ",", "list"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"first", "[", 
         RowBox[{"list", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"!", 
             RowBox[{
              RowBox[{"hasgQ", "[", "6", "]"}], "[", "#", "]"}]}], "&&", 
            RowBox[{"!", 
             RowBox[{
              RowBox[{"hasgQ", "[", "7", "]"}], "[", "#", "]"}]}]}], "&"}]}], 
         "]"}], ",", 
        RowBox[{
         RowBox[{"first", "[", 
          RowBox[{"list", ",", 
           RowBox[{"hasgQ", "[", "6", "]"}]}], "]"}], "+", 
         RowBox[{"first", "[", 
          RowBox[{"list", ",", 
           RowBox[{"hasgQ", "[", "7", "]"}]}], "]"}]}]}], "}"}]}], "]"}], ",",
     "subsets"}], "]"}]}]}], "Input",
