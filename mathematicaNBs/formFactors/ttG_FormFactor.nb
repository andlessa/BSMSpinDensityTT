Cell[BoxData[{
 RowBox[{
  RowBox[{"loopFunctionsHat", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"PaVe", "[", 
       RowBox[{"1", ",", 
        RowBox[{"{", 
         RowBox[{"Pair", "[", "x1___", "]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"mChi", "^", "2"}], ",", 
          RowBox[{"mST", "^", "2"}]}], "}"}], ",", "opt___"}], "]"}], "->", 
      RowBox[{
       RowBox[{"B1h", "[", 
        RowBox[{"Pair", "[", "x1", "]"}], "]"}], "+", 
       RowBox[{"PaVe", "[", 
        RowBox[{"1", ",", 
         RowBox[{"{", 
          RowBox[{"MT", "^", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"mChi", "^", "2"}], ",", 
           RowBox[{"mST", "^", "2"}]}], "}"}], ",", "opt"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PaVe", "[", 
       RowBox[{"0", ",", "0", ",", 
        RowBox[{"{", 
         RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"mChi", "^", "2"}], ",", 
          RowBox[{"mST", "^", "2"}], ",", 
          RowBox[{"mST", "^", "2"}]}], "}"}], ",", "opt___"}], "]"}], "->", 
      RowBox[{
       RowBox[{"C00h", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}], "-", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"PaVe", "[", 
         RowBox[{"1", ",", 
          RowBox[{"{", 
           RowBox[{"MT", "^", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"mChi", "^", "2"}], ",", 
            RowBox[{"mST", "^", "2"}]}], "}"}], ",", "opt"}], "]"}]}]}]}], 
     ",", 
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{"DB1", "[", 
        RowBox[{
         RowBox[{"MT", "^", "2"}], ",", 
         RowBox[{"mChi", "^", "2"}], ",", 
         RowBox[{"mST", "^", "2"}], ",", "___"}], "]"}], "]"}], "->", 
      RowBox[{"reDB1", "[", 
       RowBox[{"MT", "^", "2"}], "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
