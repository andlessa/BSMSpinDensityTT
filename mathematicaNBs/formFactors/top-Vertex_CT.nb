Cell["\<\
The renormalization condition requires the loop correction (plus \
counter-terms) to vanish at zero momentum (p=0=p1+p2)
Therefore it is convenient to first set p1=-p2\
\>", "Text",
 CellChangeTimes->{{3.99200334256219*^9, 3.992003351569154*^9}, {
  3.992003416161478*^9, 
  3.9920034522822533`*^9}},ExpressionUUID->"4294acd4-04bd-42df-863a-\
101efb53f393"],

