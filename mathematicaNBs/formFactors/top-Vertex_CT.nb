Cell[BoxData[
 RowBox[{"ampA", "=", 
  RowBox[{
   RowBox[{"FCFAConvert", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CreateFeynAmp", "[", 
       RowBox[{"goodDiags", ",", 
        RowBox[{"PreFactor", "\[Rule]", "1"}], ",", 
        RowBox[{"Truncated", "\[Rule]", "True"}]}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"SUNT", "\[Rule]", "FASUNT"}], ",", " ", 
        RowBox[{"GS", "\[Rule]", " ", 
         SqrtBox[
          RowBox[{"4", " ", "Pi", " ", "aS"}]]}]}], "}"}]}], ",", 
     RowBox[{"IncomingMomenta", "\[Rule]", 
      RowBox[{"{", "p", "}"}]}], ",", 
     RowBox[{"OutgoingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
     RowBox[{"LoopMomenta", "\[Rule]", 
      RowBox[{"{", "q", "}"}]}], ",", 
     RowBox[{"LorentzIndexNames", "\[Rule]", 
      RowBox[{"{", "\[Mu]", "}"}]}], ",", 
     RowBox[{"List", "\[Rule]", "False"}], ",", 
     RowBox[{"DropSumOver", "\[Rule]", "True"}], ",", 
     RowBox[{"SMP", "\[Rule]", "True"}], ",", 
     RowBox[{"List", "\[Rule]", "False"}], ",", 
     RowBox[{"Contract", "\[Rule]", "False"}], ",", 
     RowBox[{"ChangeDimension", "\[Rule]", "D"}], ",", 
     RowBox[{"UndoChiralSplittings", "\[Rule]", "True"}], ",", 
     RowBox[{"FinalSubstitutions", "\[Rule]", " ", "M$FACouplings"}]}], "]"}],
    "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"FR$deltaZ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"G", ",", "G"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", "}"}], "}"}]}], "]"}], "->", "deltaZG"}], ",", 
     RowBox[{
      RowBox[{"FR$deltaZ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", "t"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", "}"}], "}"}], ",", "\"\<L\>\""}], "]"}], "->", 
      "deltaZL"}], ",", 
     RowBox[{
      RowBox[{"FR$deltaZ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", "t"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", "}"}], "}"}], ",", "\"\<R\>\""}], "]"}], "->", 
      "deltaZR"}], ",", 
     RowBox[{
      RowBox[{"FR$delta", "[", 
       RowBox[{
        RowBox[{"{", "MT", "}"}], ",", 
        RowBox[{"{", "}"}]}], "]"}], "->", "deltaM"}], ",", 
     RowBox[{
      RowBox[{"FR$delta", "[", 
       RowBox[{
        RowBox[{"{", "aS", "}"}], ",", 
        RowBox[{"{", "}"}]}], "]"}], "->", "deltaaS"}], ",", 
     RowBox[{"aS", "->", 
      FractionBox[
       RowBox[{"gs", "^", "2"}], 
       RowBox[{"4", " ", "Pi"}]]}]}], "}"}]}]}]], "Input",
