Cell[CellGroupData[{

Cell["Construct ALOHA terms", "Section",
 CellChangeTimes->{{3.90282439728789*^9, 
  3.9028244054044323`*^9}},ExpressionUUID->"61d6f6bd-d2f9-4207-a421-\
9d5a603aed82"],

Cell["\<\

UFO conventions:
ProjM -> Gamma[7], ProjP -> Gamma[6]
particles = [ P.t__tilde __, P.t, P.g, P.g ] ] = [ p1=P(*,1),  p2=P(*,2), p3(\
\[Mu])=P(*,3), p4(\[Nu])=P(*,4) ] (all momenta are incoming)
 c1 = Anti-Top color = \[OpenCurlyDoubleQuote]1\[CloseCurlyDoubleQuote], c2 = \
Top color = \[OpenCurlyDoubleQuote]2\[CloseCurlyDoubleQuote], c3 = Gluon \
color = \[OpenCurlyDoubleQuote]3\[CloseCurlyDoubleQuote], c4 = Gluon color = \
\[OpenCurlyDoubleQuote]4\[CloseCurlyDoubleQuote]
spins = [2, 2, 3], 
structure = \[OpenCurlyQuote] P (4, 3)*Gamma (3, 2, -1)*ProjP (-1, 1) - P (3, \
4)*Gamma (4, 2, -1)*ProjP (-1, 1)\[CloseCurlyQuote])

s = (p1+p2)^2 =  P(-1,1)**2 + P(-1,2)**2 + 2*P(-1,1)*P(-1,2)
t = (p1+p3)^2  = P(-1,1)**2 + P(-1,3)**2 + 2*P(-1,1)*P(-1,3)
u = (p1+p4)^2  = (p2+p3)^2 = P(-1,2)**2 + P(-1,3)**2 + 2*P(-1,2)*P(-1,3) 
(The indices of the product of gamma matrices are always M(2,1), since the \
second (outgoing) top is contract to the left and the first (incoming) to the \
right)
\
\>", "Text",
 CellChangeTimes->{{3.9028244127388268`*^9, 3.9028244572997704`*^9}, {
   3.9028245494877653`*^9, 3.902824565289369*^9}, {3.902825135407077*^9, 
   3.902825165986191*^9}, {3.9028252069681892`*^9, 3.902825209358458*^9}, {
   3.902827635902626*^9, 3.9028276404204607`*^9}, {3.902828503425274*^9, 
   3.902828598854724*^9}, {3.902828648303794*^9, 3.902828650321616*^9}, {
   3.902841286902041*^9, 3.902841414274*^9}, {3.904227420309002*^9, 
   3.90422742685322*^9}, 
   3.904301439203808*^9},ExpressionUUID->"ac0703dd-34fe-4090-8a2e-\
872b9b5d1d5e"],

