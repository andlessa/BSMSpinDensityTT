         RowBox[{"List", "@@", "#"}], ",", 
         RowBox[{
          RowBox[{"MatchQ", "[", 
           RowBox[{"#", ",", "_DiracGamma"}], "]"}], "&"}]}], "]"}], "&"}]}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
