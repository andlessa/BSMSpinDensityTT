Cell[CellGroupData[{

Cell["\<\
Split terms according to the tensor structure and color structure and factor \
out the vertex coupling\
\>", "Subsection",
 CellChangeTimes->{{3.992108858485496*^9, 3.992108886133624*^9}, {
  3.992346801626999*^9, 
  3.9923468061853848`*^9}},ExpressionUUID->"e00bec8d-5405-4b3a-98ed-\
d6a595947869"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ampEsimp6", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Expand", "[", "ampEsimp5", "]"}], ",", "_PaVe", ",", 
     "Simplify"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99236578579126*^9, 3.992365790797711*^9}, {
  3.992366247475029*^9, 3.992366266435438*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"061848a5-3a66-43e4-b661-4dbcd867a512"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"couplingTerms", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gs", "^", 
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "gs"}], "]"}]}], " ", 
        RowBox[{"yDM", "^", 
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "yDM"}], "]"}]}]}], ")"}], "&"}], "/@", 
     RowBox[{"List", "@@", 
      RowBox[{"Expand", "[", "ampEsimp6", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"globalFactor", " ", "=", " ", 
   RowBox[{"I", " ", 
    RowBox[{"Pi", "^", "2"}]}]}], ";", 
  RowBox[{"structTerms", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Times", "@@", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", "^", 
             RowBox[{"{", 
              RowBox[{"Exponent", "[", 
               RowBox[{"term", ",", "d"}], "]"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"dList", ",", 
             RowBox[{"{", 
              RowBox[{"diracStructures", ",", "momentumStructures"}], "}"}]}],
             "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", "dList"}], "}"}]}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"term", ",", 
         RowBox[{"List", "@@", 
          RowBox[{"Expand", "[", "ampEsimp6", "]"}]}]}], "}"}]}], "]"}], 
     "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coefficients", "=", 
    RowBox[{"Join", "@@", 
     RowBox[{"Join", "@@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"coupling", "*", "globalFactor"}], ",", "colorStructure", 
          ",", "structure", ",", 
          RowBox[{"Collect", "[", 
           RowBox[{
            RowBox[{"Expand", "[", 
             RowBox[{"Coefficient", "[", 
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{
                 RowBox[{"Coefficient", "[", 
                  RowBox[{
                   RowBox[{"Expand", "[", 
                    FractionBox["ampEsimp6", "globalFactor"], "]"}], ",", 
                   "coupling"}], "]"}], ",", "colorStructure"}], "]"}], ",", 
               "structure"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"_C00", ",", "_B1", ",", "_PaVe"}], "}"}], ",", 
            "FullSimplify"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"structure", ",", "structTerms"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"colorStructure", ",", "colorStructures"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"coupling", ",", "couplingTerms"}], "}"}]}], "]"}]}]}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Select", " ", "only", " ", "non"}], "-", 
    RowBox[{"zero", " ", "coefficients"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coefficients", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"coefficients", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], "=!=", "0"}], "&"}]}], "]"}]}], 
