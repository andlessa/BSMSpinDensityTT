43fab5607eb0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"momRep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p1sq", "->", 
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"p1", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p1", ",", "D"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"p2sq", "->", 
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"p2", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p2", ",", "D"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"p3sq", "->", 
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"p3", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p3", ",", "D"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"p4sq", "->", 
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"p4", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p4", ",", "D"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"s", "->", 
      RowBox[{"p1sq", "+", "p2sq", "+", 
       RowBox[{"2", 
        RowBox[{"Pair", "[", 
         RowBox[{
          RowBox[{"Momentum", "[", 
           RowBox[{"p1", ",", "D"}], "]"}], ",", 
          RowBox[{"Momentum", "[", 
           RowBox[{"p2", ",", "D"}], "]"}]}], "]"}]}]}]}], ",", 
     RowBox[{"u", "->", 
      RowBox[{"p1sq", "+", "p4sq", "+", 
       RowBox[{"2", 
        RowBox[{"Pair", "[", 
         RowBox[{
          RowBox[{"Momentum", "[", 
           RowBox[{"p1", ",", "D"}], "]"}], ",", 
          RowBox[{"Momentum", "[", 
           RowBox[{"p4", ",", "D"}], "]"}]}], "]"}]}]}]}], ",", 
     RowBox[{"t", "->", 
      RowBox[{"p1sq", "+", "p3sq", "+", 
       RowBox[{"2", 
        RowBox[{"Pair", "[", 
         RowBox[{
          RowBox[{"Momentum", "[", 
           RowBox[{"p1", ",", "D"}], "]"}], ",", 
          RowBox[{"Momentum", "[", 
           RowBox[{"p3", ",", "D"}], "]"}]}], "]"}]}]}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coefficientSimp2", "=", 
   RowBox[{"coefficientSimp", "//.", "momRep"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992369108709659*^9, 3.992369206855587*^9}, {
