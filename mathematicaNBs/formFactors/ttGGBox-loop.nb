D12c(0,u,p1sq,s,p2sq,0) + D12d(0,0,p1sq,p2sq,s,u)))\\\\\\n      +   \
P(3,3)*P(4,1)*(4*D112d(0,0,p1sq,p2sq,s,u) + 2*(D11d(0,0,p1sq,p2sq,s,u) + \
D12d(0,0,p1sq,p2sq,s,u)) + D1d(0,0,p1sq,p2sq,s,u))\\\\\\n      +   \
P(3,3)*P(4,2)*(4*D112c(0,u,p1sq,s,p2sq,0) + 4*D112d(0,0,p1sq,p2sq,s,u) + \
2*(D11d(0,0,p1sq,p2sq,s,u) + D12c(0,u,p1sq,s,p2sq,0) + \
D12d(0,0,p1sq,p2sq,s,u)) + D1d(0,0,p1sq,p2sq,s,u))\\\\\\n      +   \
