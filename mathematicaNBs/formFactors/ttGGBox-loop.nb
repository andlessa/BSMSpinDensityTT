Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"vertexCounter", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<------------------\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"su3Matrices", "[", 
       RowBox[{"[", "n", "]"}], "]"}], "/.", "su3Replacements"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Select", " ", "all", " ", "terms", " ", "containing", " ", "the", " ", 
      "desired", " ", "SU3", " ", "matrix"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"terms0", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"su3Terms", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
         RowBox[{"su3Matrices", "[", 
          RowBox[{"[", "n", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Select", " ", "all", " ", "terms", " ", "containing", " ", "the", " ", 
       "desired", " ", "gamma", " ", "structure"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"terms1", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"terms0", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", 
            RowBox[{"tensors", "[", 
             RowBox[{"[", "m", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vertexCounter", " ", "+=", " ", "1"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<FFVVNP\>\"", ",", 
          RowBox[{"ToString", "[", "vertexCounter", "]"}]}], "]"}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"tensors", "[", 
            RowBox[{"[", "m", "]"}], "]"}], "/.", "tensorReplacements"}], 
          "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Compute", " ", "the", " ", "ALOHA", " ", "term", " ", "for", " ", 
         "this", " ", 
         RowBox[{"tensor", "/", "gamma"}], " ", "structure", " ", "and", " ", 
         "color", " ", "factor"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"terms", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"StringJoin", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"StringJoin", "[", 
              RowBox[{
               RowBox[{"Cases2", "[", 
                RowBox[{
                 RowBox[{"terms1", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "3"}], "]"}], "]"}], ",", "Pair"}], 
                "]"}], "/.", "momentaReplacements"}], "]"}], ")"}], ",", 
            "\"\<(\>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"FortranForm", "[", 
              RowBox[{"terms1", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "4"}], "]"}], "]"}], "]"}], "]"}], ",", 
            "\"\<)\\\\\\n      +   \>\""}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"Length", "[", "terms1", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"terms", ",", 
         RowBox[{"StringJoin", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"StringJoin", "[", 
             RowBox[{
              RowBox[{"Cases2", "[", 
               RowBox[{
                RowBox[{"terms1", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"Length", "[", "terms1", "]"}], ",", "3"}], "]"}], 
                 "]"}], ",", "Pair"}], "]"}], "/.", "momentaReplacements"}], 
             "]"}], ")"}], ",", "\"\<(\>\"", ",", 
           RowBox[{"ToString", "[", 
            RowBox[{"FortranForm", "[", 
             RowBox[{"terms1", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"Length", "[", "terms1", "]"}], ",", "4"}], "]"}], 
              "]"}], "]"}], "]"}], ",", "\"\<)\>\""}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"terms", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"StringJoin", "[", 
             RowBox[{"\"\<     \>\"", ",", 
              RowBox[{"terms", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "terms", "]"}]}], "}"}]}], "]"}]}], 
         ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fullStr", " ", "=", " ", 
        RowBox[{"StringJoin", "[", "terms", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fullStr", " ", "=", " ", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<( \>\"", ",", 
          RowBox[{
           RowBox[{"tensors", "[", 
            RowBox[{"[", "m", "]"}], "]"}], "/.", "tensorReplacements"}], 
          ",", "\"\< )*(\\\\\\n  \>\"", ",", "fullStr", ",", 
          "\"\<\\\\\\n  )\>\""}], "]"}]}], ";", "\[IndentingNewLine]", " ", 
       RowBox[{"Print", "[", "fullStr", "]"}], ";"}], "\[IndentingNewLine]", 
      ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "1", ",", 
        RowBox[{"Length", "[", "tensors", "]"}]}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", 
     RowBox[{"Length", "[", "su3Matrices", "]"}]}], "}"}]}], "]"}]}], "Input",\

