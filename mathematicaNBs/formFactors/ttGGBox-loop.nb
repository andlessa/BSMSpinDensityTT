Cell[BoxData[
 FormBox["\<\"( P(-1,1)*Gamma(-1,2,-2)*ProjP(-2,1) )*(\\\\\\n  \
Metric(3,4)*(4*D001c(0,p1sq,p2sq,0,u,s))\\\\\\n      +   \
P(3,1)*P(4,1)*(2*(2*D111c(0,p1sq,p2sq,0,u,s) + \
D11c(0,p1sq,p2sq,0,u,s)))\\\\\\n      +   \
P(3,1)*P(4,2)*(2*(2*(D111c(0,p1sq,p2sq,0,u,s) + D112c(0,p1sq,p2sq,0,u,s)) + \
D11c(0,p1sq,p2sq,0,u,s)))\\\\\\n      +   \
P(3,1)*P(4,3)*(-2*(2*D112a(p1sq,0,0,p2sq,u,s) + D11c(0,p1sq,p2sq,0,u,s)))\\\\\
\\n      +   P(3,2)*P(4,1)*(2*(2*D111c(0,p1sq,p2sq,0,u,s) + \
2*D112c(0,p1sq,p2sq,0,u,s) + D11c(0,p1sq,p2sq,0,u,s) + \
D12c(0,p1sq,p2sq,0,u,s)))\\\\\\n      +   \
P(3,2)*P(4,2)*(2*(2*D111c(0,p1sq,p2sq,0,u,s) + 2*D112b(p2sq,p1sq,0,0,s,u) + \
4*D112c(0,p1sq,p2sq,0,u,s) + D11c(0,p1sq,p2sq,0,u,s) + \
D12c(0,p1sq,p2sq,0,u,s)))\\\\\\n      +   \
P(3,2)*P(4,3)*(-2*(2*D112a(p1sq,0,0,p2sq,u,s) + D11c(0,p1sq,p2sq,0,u,s) + \
2*D123d(0,0,p1sq,p2sq,s,u) + D12c(0,p1sq,p2sq,0,u,s)))\\\\\\n      +   \
P(3,3)*P(4,1)*(-4*D112a(p1sq,0,0,p2sq,u,s) - 2*(D11c(0,p1sq,p2sq,0,u,s) + \
D12d(0,0,p1sq,p2sq,s,u)) - D1c(0,p1sq,p2sq,0,u,s))\\\\\\n      +   \
P(3,3)*P(4,2)*(-4*D112a(p1sq,0,0,p2sq,u,s) - 2*(D11c(0,p1sq,p2sq,0,u,s) + \
2*D123d(0,0,p1sq,p2sq,s,u) + D12c(0,p1sq,p2sq,0,u,s) + \
D12d(0,0,p1sq,p2sq,s,u)) - D1c(0,p1sq,p2sq,0,u,s))\\\\\\n      +   \
P(3,3)*P(4,3)*(4*(D112d(0,0,p1sq,p2sq,s,u) + D12d(0,0,p1sq,p2sq,s,u)) + \
D1c(0,p1sq,p2sq,0,u,s))\\\\\\n  )\"\>", TraditionalForm]], "Print",
