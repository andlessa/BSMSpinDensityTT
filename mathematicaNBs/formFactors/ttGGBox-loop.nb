D12c(0,u,p1sq,s,p2sq,0) + D12d(0,0,p1sq,p2sq,s,u)))\\\\\\n      +   \
P(3,2)*P(4,2)*(-2*(2*D112a(p1sq,0,0,p2sq,u,s) + 2*D112b(p1sq,u,0,s,0,p2sq) + \
