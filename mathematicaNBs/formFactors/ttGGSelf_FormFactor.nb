Cell[BoxData[{
 RowBox[{
  RowBox[{"couplingTerms", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gs", "^", 
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "gs"}], "]"}]}], " ", 
        RowBox[{"yDM", "^", 
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "yDM"}], "]"}]}]}], ")"}], "&"}], "/@", 
     RowBox[{"List", "@@", 
      RowBox[{"Expand", "[", "ampEsimp6", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"globalFactor", " ", "=", " ", 
   RowBox[{"I", " ", 
    RowBox[{"Pi", "^", "2"}]}]}], ";", 
  RowBox[{"structTerms", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Times", "@@", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", "^", 
             RowBox[{"{", 
              RowBox[{"Exponent", "[", 
               RowBox[{"term", ",", "d"}], "]"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"dList", ",", 
