Cell[CellGroupData[{

Cell["g-g- t- t (self energy)", "Section",
 CellChangeTimes->{{3.8965094536222267`*^9, 3.8965095038654137`*^9}, {
  3.9013532598632402`*^9, 3.9013532620752897`*^9}, {3.901353311683537*^9, 
  3.901353312659729*^9}, {3.902499251144042*^9, 3.902499254245419*^9}, {
  3.902695786498644*^9, 3.9026957882478437`*^9}, {3.9925409353412933`*^9, 
  3.9925409366180143`*^9}},ExpressionUUID->"516730a2-1924-46fd-a7e9-\
4e7d160046e0"],

Cell["\<\
The choice below for the momenta and the ordering of the particles in the \
process is equivalent to the correct
ordering for computing the effective vertex for the UFO format:
0 \[Rule]4, with {} \[Rule]{-F[3],F[3],V[1],V[1]} and all the momenta set as \
outgoing ({} \[Rule] {p1,p2,p3,p4}).
However the choice below produces nicer diagrams.\
\>", "Text",
 CellChangeTimes->{{3.9049219286801043`*^9, 3.90492205503379*^9}, {
  3.904922124889674*^9, 3.90492217759822*^9}, {3.992698958418137*^9, 
  3.992698963306254*^9}},ExpressionUUID->"43fcab20-cb48-4462-afb2-\
5f0fa692775d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"topsCT", " ", "=", " ", 
   RowBox[{"CreateCTTopologies", "[", 
    RowBox[{"1", ",", 
     RowBox[{"2", "\[Rule]", "2"}], ",", 
     RowBox[{"ExcludeTopologies", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "WFCorrectionCTs", ",", "TadpoleCTs", ",", "BoxCTs", ",", 
        "TriangleCTs"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tops", " ", "=", " ", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"1", ",", 
     RowBox[{"2", "\[Rule]", "2"}], ",", "  ", 
     RowBox[{"ExcludeTopologies", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"TadpoleCTs", ",", "Tadpoles", ",", "WFCorrections"}], 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"processGGT", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"V", "[", "1", "]"}], ",", 
      RowBox[{"V", "[", "1", "]"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"F", "[", "3", "]"}]}], ",", 
      RowBox[{"F", "[", "3", "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allDiags", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{"topsCT", ",", "tops"}], "]"}], ",", "processGGT", ",", " ", 
     RowBox[{"InsertionLevel", "\[Rule]", " ", 
      RowBox[{"{", "Particles", "}"}]}], ",", 
     RowBox[{"ExcludeParticles", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"V", "[", "3", "]"}], ",", 
        RowBox[{"V", "[", "1", "]"}]}], "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.896509435366342*^9, 3.896509451223157*^9}, {
   3.8965095108569107`*^9, 3.8965095604144707`*^9}, {3.896509597031486*^9, 
