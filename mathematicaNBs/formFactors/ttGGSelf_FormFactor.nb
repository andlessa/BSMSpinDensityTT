43fab5607eb0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"momRep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p1sq", "->", 
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"p1", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p1", ",", "D"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"p2sq", "->", 
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"p2", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p2", ",", "D"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"p3sq", "->", 
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"p3", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p3", ",", "D"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"p4sq", "->", 
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"p4", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p4", ",", "D"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"s", "->", 
      RowBox[{"p1sq", "+", "p2sq", "+", 
       RowBox[{"2", 
        RowBox[{"Pair", "[", 
         RowBox[{
          RowBox[{"Momentum", "[", 
           RowBox[{"p1", ",", "D"}], "]"}], ",", 
          RowBox[{"Momentum", "[", 
           RowBox[{"p2", ",", "D"}], "]"}]}], "]"}]}]}]}], ",", 
     RowBox[{"u", "->", 
