Cell[BoxData[{
 RowBox[{
  RowBox[{"gluon1Index", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gluon2Index", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"topIndex", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"antiTopIndex", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"leftIndex", "=", "topIndex"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rightIndex", "=", "antiTopIndex"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"momentumMap", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"p1", "->", "antiTopIndex"}], ",", 
     RowBox[{"p2", "->", "topIndex"}], ",", 
     RowBox[{"p3", "->", "gluon1Index"}], ",", 
     RowBox[{"p4", "->", "gluon2Index"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lorentzMap", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\[Mu]", "->", "gluon1Index"}], ",", 
     RowBox[{"\[Nu]", "->", "gluon2Index"}]}], "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colorMap", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"cc3", "->", "gluon1Index"}], ",", 
     RowBox[{"cc4", "->", "gluon2Index"}], ",", 
     RowBox[{"c2", "->", "topIndex"}], ",", 
     RowBox[{"c1", "->", "antiTopIndex"}]}], "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opts", "=", 
   RowBox[{"Sequence", "@@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MomentumMap", "->", "momentumMap"}], ",", 
      RowBox[{"LorentzMap", "->", "lorentzMap"}], ",", 
      RowBox[{"ColorMap", "->", "colorMap"}], ",", "\[IndentingNewLine]", 
      RowBox[{"LeftIndex", "->", "leftIndex"}], ",", 
      RowBox[{"RightIndex", "->", "rightIndex"}]}], "}"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9921278248032503`*^9, 3.992127825623722*^9}, {
