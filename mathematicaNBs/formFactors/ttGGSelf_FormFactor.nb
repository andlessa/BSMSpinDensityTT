          RowBox[{"Momentum", "[", 
           RowBox[{"p1", ",", "D"}], "]"}], ",", 
          RowBox[{"Momentum", "[", 
           RowBox[{"p3", ",", "D"}], "]"}]}], "]"}]}]}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coefficientSimp2", "=", 
   RowBox[{"coefficientSimp", "//.", "momRep"}]}], ";"}]}], "Input",
