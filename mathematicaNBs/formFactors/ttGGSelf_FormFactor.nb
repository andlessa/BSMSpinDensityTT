064cae77ea4b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"spinorChains", "=", 
   RowBox[{"DeleteDuplicates", "@", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Cases", "[", 
       RowBox[{"ampEsimp5", ",", "_Dot", ",", "Infinity"}], "]"}], ",", 
      RowBox[{
       RowBox[{"VectorQ", "[", 
        RowBox[{
         RowBox[{"List", "@@", "#"}], ",", 
         RowBox[{
          RowBox[{"MatchQ", "[", 
           RowBox[{"#", ",", "_DiracGamma"}], "]"}], "&"}]}], "]"}], "&"}]}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"singleGamma", "=", 
   RowBox[{"DeleteDuplicates", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"ampEsimp5", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Count", "[", 
           RowBox[{"#", ",", "_DiracGamma", ",", "Infinity"}], "]"}], "==", 
          "1"}], "&"}]}], "]"}], ",", "_DiracGamma", ",", "All"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"diracStructures", "=", 
  RowBox[{"Sort", "[", 
   RowBox[{"DeleteDuplicates", "@", 
    RowBox[{"Join", "[", 
     RowBox[{"singleGamma", ",", "spinorChains"}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"momentumStructures", "=", 
    RowBox[{"Sort", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"Cases2", "[", 
        RowBox[{"ampEsimp5", ",", "Pair", ",", "All"}], "]"}]}], "]"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Remove", " ", "appearances", " ", "of", " ", 
     RowBox[{"pi", "^", "2"}]}], ",", " ", 
    RowBox[{
    "since", " ", "they", " ", "do", " ", "not", " ", "contribute", " ", "to",
      " ", "the", " ", "tensor", " ", "structure"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"momentumStructures", "=", 
