Cell[CellGroupData[{

Cell[TextData[{
 "Finally, for convenience, define pB1h to artificial numerical divergences :\
\n",
 StyleBox["(note that ", "Text"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"pB1h", "[", 
     SuperscriptBox["p", "2"], "]"}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SuperscriptBox["p", "2"], "-", 
        SuperscriptBox["MT", "2"]}]], 
      RowBox[{"B1h", "[", 
       SuperscriptBox["p", "2"], "]"}]}], "->", 
     RowBox[{
      RowBox[{
       RowBox[{"DB1", "[", 
        SuperscriptBox["MT", "2"], "]"}], "  ", "for", " ", 
       SuperscriptBox["p", "2"]}], "->", " ", 
      SuperscriptBox["MT", "2"]}]}]}], TraditionalForm]], "Text",
  ExpressionUUID->"e98894a1-c7c8-4d87-a112-6112901d2298"], "Text"],
 StyleBox[" and ", "Text"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p2B1h", "[", 
     SuperscriptBox["p", "2"], "]"}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["p", "2"], "-", 
         SuperscriptBox["MT", "2"]}], ")"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"pB1h", "[", 
         SuperscriptBox["p", "2"], "]"}], "-", 
        RowBox[{"pB1h", "[", 
         SuperscriptBox["MT", "2"], "]"}]}], ")"}]}], "=", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["p", "2"], "-", 
           SuperscriptBox["MT", "2"]}], ")"}], "2"]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"B1h", "[", 
          SuperscriptBox["p", "2"], "]"}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["p", "2"], "-", 
            SuperscriptBox["MT", "2"]}], ")"}], 
          RowBox[{"DB1", "[", 
           SuperscriptBox["MT", "2"], "]"}]}]}], ")"}]}], "->", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox["D", "2"], 
       RowBox[{"B1", "[", 
        SuperscriptBox["MT", "2"], "]"}]}]}]}]}], TraditionalForm]], "Text",
  ExpressionUUID->"cc6bdc76-5cbb-46df-aafd-de0bdb149c67"],
 " )"
}], "Subsection",
