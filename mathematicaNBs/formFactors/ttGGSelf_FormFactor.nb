        RowBox[{
         RowBox[{"(", 
          RowBox[{"x1", "-", 
           RowBox[{"MT", "^", "2"}]}], ")"}], 
         RowBox[{"p2B1h", "[", "x1", "]"}]}], "+", 
        RowBox[{"pB1h", "[", 
         RowBox[{"MT", "^", "2"}], "]"}]}]}], "}"}]}], "/.", 
    RowBox[{"{", 
