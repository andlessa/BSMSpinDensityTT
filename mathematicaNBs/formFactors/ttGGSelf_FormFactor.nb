         RowBox[{"-", "p2"}], ",", 
         RowBox[{"-", "p1"}]}], "}"}]}], ",", 
      RowBox[{"LoopMomenta", "\[Rule]", 
       RowBox[{"{", "q", "}"}]}], ",", 
