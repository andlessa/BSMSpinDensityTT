Cell[BoxData[{
 RowBox[{
  RowBox[{"momentumMap", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"p1", "->", "antiTopIndex"}], ",", 
     RowBox[{"p2", "->", "topIndex"}], ",", 
     RowBox[{"p3", "->", "gluonIndex"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lorentzMap", "=", 
   RowBox[{"<|", 
    RowBox[{"\[Mu]", "->", "gluonIndex"}], "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colorMap", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"cc3", "->", "gluonIndex"}], ",", 
      RowBox[{"c2", "->", "topIndex"}], ",", 
      RowBox[{"c1", "->", "antiTopIndex"}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Helper", " ", "functions", " ", "for", " ", "converting", " ", "know", 
    " ", "indices", " ", "and", " ", "dummy", " ", "indices"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"momentumIndex", "[", "p_", "]"}], ":=", 
  RowBox[{"Lookup", "[", 
   RowBox[{"momentumMap", ",", "p", ",", "p"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"lorentzIndex", "[", 
   RowBox[{"LorentzDummy", "[", "mu_", "]"}], "]"}], ":=", 
  "mu"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lorentzIndex", "[", "mu_", "]"}], ":=", 
   RowBox[{"Lookup", "[", 
    RowBox[{"lorentzMap", ",", "mu", ",", "mu"}], "]"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "the", " ", "external", " ", "indices", " ", "for", " ", 
    "the", " ", "Dirac", " ", "chains"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spinIndices", "[", "n_", "]"}], ":=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", "leftIndex", "}"}], ",", 
     RowBox[{"-", 
      RowBox[{"Range", "[", 
       RowBox[{"n", "-", "1"}], "]"}]}], ",", 
     RowBox[{"{", "rightIndex", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Helper", " ", "function", " ", "for", " ", "creating", " ", "dummy", " ", 
    "indices"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initDummyIndex", "=", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Values", "[", "momentumMap", "]"}], ",", 
       RowBox[{"Values", "[", "lorentzMap", "]"}], ",", 
       RowBox[{"Values", "[", "colorMap", "]"}]}], "]"}], "]"}], "+", "1"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"currentDummyIndex", "=", "initDummyIndex"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newDummyLorentz", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "mu", "}"}], ",", 
    RowBox[{
     RowBox[{"mu", "=", 
      RowBox[{"LorentzDummy", "[", "currentDummyIndex", "]"}]}], ";", 
     RowBox[{"currentDummyIndex", "++"}], ";", "mu"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"resetLorentz", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", 
    RowBox[{
     RowBox[{"currentDummyIndex", "=", "initDummyIndex"}], ";"}]}], 
   "]"}]}]}], "Input",
