        RowBox[{"yDM", "^", "2"}], " ", "gs", " ", 
        RowBox[{"Pi", "^", "2"}]}]], 
      RowBox[{"Coefficient", "[", 
       RowBox[{"deltaB2e", ",", 
        RowBox[{
         RowBox[{"SUNT", "[", 
          RowBox[{
           RowBox[{"Index", "[", 
            RowBox[{"Gluon", ",", 
             RowBox[{"Ext", "[", "3", "]"}]}], "]"}], ",", 
           RowBox[{"Index", "[", 
            RowBox[{"Colour", ",", 
             RowBox[{"Ext", "[", "1", "]"}]}], "]"}], ",", 
           RowBox[{"Index", "[", 
            RowBox[{"Colour", ",", 
             RowBox[{"Ext", "[", "2", "]"}]}], "]"}]}], "]"}], "*", 
         RowBox[{
          RowBox[{"TensDot", "[", 
           RowBox[{
            RowBox[{"Ga", "[", 
             RowBox[{"Index", "[", 
              RowBox[{"Lorentz", ",", 
               RowBox[{"Ext", "[", "3", "]"}]}], "]"}], "]"}], ",", "ProjM"}],
            "]"}], "[", 
          RowBox[{
           RowBox[{"Index", "[", 
            RowBox[{"Spin", ",", 
             RowBox[{"Ext", "[", "1", "]"}]}], "]"}], ",", 
           RowBox[{"Index", "[", 
            RowBox[{"Spin", ",", 
             RowBox[{"Ext", "[", "2", "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], 
     ",", 
     RowBox[{"{", "\[Epsilon]", "}"}], ",", "FullSimplify"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
