Cell[CellGroupData[{

Cell["Case 1 (On - shell decay) : mChi \[NotEqual] MT, mST > mChi + MT", \
"Subsubsection",
 CellChangeTimes->{{3.9018100038946333`*^9, 3.901810018201231*^9}, {
  3.901810050532235*^9, 3.9018100812048903`*^9}, {3.901810198717675*^9, 
  3.901810241209239*^9}, {3.901810294035613*^9, 
  3.901810296639288*^9}},ExpressionUUID->"e57abf24-cb8e-4f9f-8f51-\
50f51c571640"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Assumptions1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mChi", " ", "\[NotEqual]", " ", "MT"}], ",", 
     RowBox[{"mST", ">", 
      RowBox[{"(", 
       RowBox[{"mChi", "+", "MT"}], ")"}]}], ",", 
     RowBox[{"xT", ">", "0"}], ",", 
     RowBox[{"xC", ">", "0"}], ",", 
     RowBox[{"lA", ">", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"Assumptions0", ",", "Assumptions1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"subs1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MT", "\[Rule]", " ", 
      RowBox[{
       SqrtBox["xT"], " ", "mST"}]}], ",", 
     RowBox[{"mChi", "\[Rule]", " ", 
      RowBox[{
       SqrtBox["xC"], " ", "mST"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"subs2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"xC", "^", "2"}], " ", "-", " ", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"xT", "+", "1"}], ")"}], " ", "xC"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xT", "-", "1"}], ")"}], "^", "2"}]}], ")"}], "\[Rule]", " ",
      "lA"}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.90361523482943*^9, 3.9036152837987328`*^9}, {
   3.903627946602113*^9, 3.903627955296527*^9}, 3.903628166167656*^9, {
